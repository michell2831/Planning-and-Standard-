{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": ".",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "scripts/data/**/*.json",
        "outDir": "dist",
        "watchAssets": false
      }
    ]
  },
  "entryFile": "modules/service-catalogue/main"
}